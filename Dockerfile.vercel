# All-in-one image for Vercel's container runtime (beta).
# Vercel detects this file in the repository root, builds it with the root as
# build context, and routes every request to the container.
#
# The build is the same as ./Dockerfile (the single-service image used on
# Render); a test keeps the two in step. Only the last section differs: the
# start command adapts Vercel's environment (scripts/vercel/start.sh) and the
# home directory is somewhere writable.
#
# Status: EXPERIMENTAL. This image has not been built or run on Vercel.
# See docs/deploy-vercel.md.

# ---- frontend: the same build as frontend/Dockerfile
FROM node:24.14.1-alpine3.23 AS frontend

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# ---- backend
FROM ghcr.io/astral-sh/uv:0.11.3@sha256:90bbb3c16635e9627f49eec6539f956d70746c409209041800a0280b93152823 AS uv
FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258

COPY --from=uv /uv /uvx /bin/
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy \
    UV_NO_CACHE=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 UV_CONCURRENT_DOWNLOADS=4 \
    UV_HTTP_TIMEOUT=300
WORKDIR /app

# Dependencies first, so a source change does not reinstall them. The check
# fails the build if the detection model is not inside the image.
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --locked --no-install-project \
    && .venv/bin/python -c "import en_core_web_sm; en_core_web_sm.load(disable=['parser'])"

COPY backend/ ./
# Compile the application once here: the container starts three short Python
# processes on a small CPU share, and none of them may write bytecode at runtime.
RUN uv sync --locked \
    && .venv/bin/python -m compileall -q app migrations \
    && useradd --system --uid 10001 --create-home privacyshield

COPY --from=frontend /app/dist /app/static

USER 10001
# HOME is /tmp because the platform may run the container as another user with
# a read-only image filesystem; /tmp is the one place sure to be writable.
ENV PATH="/app/.venv/bin:$PATH" STATIC_DIR=/app/static JOB_RUNNER=inline HOME=/tmp
# Vercel routes to the port in the PORT project variable (set PORT=10000), or to
# 80 when it is not set. The start script listens on whichever applies.
EXPOSE 10000

CMD ["sh", "/app/scripts/vercel/start.sh"]
